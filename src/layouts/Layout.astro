---
import { ClientRouter } from "astro:transitions";
import { PUBLIC_CF_ANALYTICS_TOKEN } from "astro:env/client";
import Footer from "~/components/Footer";
import NavBar from "~/islands/NavBar";
import "~/app.css";

interface Props {
	title?: string;
}
const { title = "Schizophrenia poll" } = Astro.props;
---

<html lang="en" class="slide">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
		<ClientRouter />
		{
			/*
			 * Cloudflare Web Analytics: no cookies, no IPs stored. Loaded once in <head>; it follows
			 * ClientRouter's page changes itself (History API), so no per-page code is needed.
			 * Use the "manually installed JS snippet" option in Cloudflare, not automatic
			 * injection, or pages would get a second beacon.
			 */
			import.meta.env.PROD && PUBLIC_CF_ANALYTICS_TOKEN && (
				<script
					is:inline
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={JSON.stringify({ token: PUBLIC_CF_ANALYTICS_TOKEN })}
				/>
			)
		}
	</head>
	<body class="min-h-screen lg:shadow-[inset_0px_0px_200px_rgba(0,0,0,0.9)] lg:shadow-blue-300">
		<NavBar client:only="solid-js" transition:persist />
		<slot />
		<Footer />
	</body>
</html>
