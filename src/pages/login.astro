---
import Layout from "~/layouts/Layout.astro";
import LoginButton from "~/islands/LoginButton";
import { safeRedirect } from "~/utils/auth-client";

const redir = safeRedirect(Astro.url.searchParams.get("redir"));
if (Astro.locals.user) return Astro.redirect(redir);
const failed = Astro.url.searchParams.has("error");
---

<Layout title="Sign in · Schizophrenia poll">
	<main
		class="flex min-h-screen w-full flex-col items-center justify-center bg-slate-100 lg:shadow-[inset_0px_0px_200px_rgba(0,0,0,0.9)] lg:shadow-blue-300"
	>
		<h1 class="my-16 font-bold text-5xl lg:text-6xl">Sign in</h1>
		<div
			class="mb-16 flex w-11/12 max-w-2xl flex-col justify-start gap-6 rounded-3xl border-fuchsia-600 border-t-4 bg-white px-4 py-12 shadow-xl lg:p-16"
		>
			<p class="text-lg">
				Sign in with your Discord account. This site only stores your Discord account ID, not
				your email, username or avatar. You can delete your account and all your data at any
				time.
			</p>
			{failed && <p class="text-red-600">Sign in failed or was cancelled. Please try again.</p>}
			<LoginButton client:load redir={redir} />
		</div>
	</main>
</Layout>
