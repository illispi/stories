---
import Layout from "~/layouts/Layout.astro";
import { isFOrT, isPOrT } from "~/server/params";
import Compare from "~/views/Compare";

const { pOrT, fOrT } = Astro.params;
if (!isPOrT(pOrT) || !isFOrT(fOrT)) return Astro.rewrite("/404");
---

<Layout title="Compare · Schizophrenia poll">
	<Compare client:only="solid-js" params={{ pOrT, fOrT }} />
</Layout>
