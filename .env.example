# Copy to .env and fill in. Production values are set as runtime secrets on the server/container.

# --- Postgres ---
PSQL_HOST=localhost
PSQL_PORT=5432
PSQL_DATABASE=stories
PSQL_USERNAME=postgres
# Only used by `pnpm sql-types` (kysely-codegen). Keep in sync with the PSQL_* values.
DATABASE_URL=postgres://postgres:<password>@localhost:5432/stories
PSQL_PASSWORD=

# --- Better Auth ---
# Dev-only secret, generated locally. Use a different one in production (openssl rand -base64 32).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321

# --- Discord OAuth (Developer Portal -> OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Public (baked into the client bundle; never put secrets here) ---
PUBLIC_SITE=http://localhost:4321
PUBLIC_UMAMI_ID=77657924-9c0f-47e6-9bd1-a282a883c2c9
# Sentry project → Settings → Client Keys (DSN). Empty = no error reporting.
PUBLIC_SENTRY_DSN=
