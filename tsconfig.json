{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": [
		"dist",
		"node_modules",
		"src/_legacy_routes",
		"src/components",
		"src/app.tsx"
	],
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"paths": { "~/*": ["./src/*"] }
	}
}
