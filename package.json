{
	"name": "stories",
	"scripts": {
		"dev": "astro dev --host",
		"build": "astro build",
		"start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
		"preview": "astro preview",
		"check": "astro check",
		"migrate:latest": "node ./src/utils/migrate.ts",
		"migrate:down": "node ./src/utils/migrate.ts down",
		"new:migration": "node ./src/utils/migrationFilename.ts",
		"sql-types": "kysely-codegen --dialect postgres --out-file ./src/types/db.ts"
	},
	"type": "module",
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@types/pg": "^8.11.10",
		"autoprefixer": "^10.4.20",
		"kysely-codegen": "^0.17.0",
		"postcss": "^8.5.23",
		"tailwindcss": "^3.4.14",
		"typescript": "^5.6.3"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.0",
		"@astrojs/node": "^11.0.0",
		"@astrojs/solid-js": "^7.0.0",
		"@faker-js/faker": "^10.5.0",
		"@formisch/solid": "^1.0.0",
		"@sentry/astro": "^10.6.0",
		"@solid-primitives/refs": "^1.0.8",
		"@solid-primitives/transition-group": "^1.0.5",
		"@tanstack/solid-query": "^5.59.13",
		"@trpc/client": "^11.8.0",
		"@trpc/server": "^11.8.0",
		"astro": "^7.0.0",
		"better-auth": "^1.7.16",
		"clsx": "^2.1.1",
		"dotenv": "^16.4.5",
		"echarts": "^6.0.0",
		"kysely": "^0.28.17",
		"pg": "^8.13.0",
		"sharp": "^0.35.3",
		"solid-js": "^1.9.4",
		"solid-transition-group": "^0.2.3",
		"tailwind-merge": "^2.5.4",
		"valibot": "^1.4.2",
		"zod": "^4.6.6"
	},
	"engines": {
		"node": ">=26"
	}
}
